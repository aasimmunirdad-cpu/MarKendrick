# Copy this to .env and fill in real values before deploying to production.
# Never commit the real .env file to a public repo.

# MongoDB Atlas (or any Mongo host) connection string
MONGO_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net"
DB_NAME="markendrick"

# Comma-separated list of allowed origins, or "*" for all (tighten before launch)
CORS_ORIGINS="https://markendrick.com"

# Your production frontend URL — used for CORS + building absolute links in emails/sitemap
FRONTEND_URL="https://markendrick.com"

# Generate a fresh one with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET="REPLACE_WITH_A_FRESH_RANDOM_SECRET"

# Admin login for the /admin CMS dashboard — change this password before going live
ADMIN_EMAIL="admin@markendrick.com"
ADMIN_PASSWORD="REPLACE_WITH_A_STRONG_PASSWORD"

# Email sending — pick ONE of the two options below:
# Option A: keep using Emergent's managed email proxy (requires an active Emergent subscription)
EMERGENT_EMAIL_KEY="REPLACE_IF_USING_EMERGENT_EMAIL"
# Option B: use your own Resend account instead (see README for the code swap needed)
# RESEND_API_KEY="REPLACE_WITH_YOUR_RESEND_KEY"

EMAIL_FROM_NAME="Markendrick"
OWNER_EMAIL="hello@markendrick.com"

# Optional: override where uploaded whitepaper PDFs are stored (defaults to ./uploads)
# UPLOAD_DIR="/var/data/markendrick-uploads"
